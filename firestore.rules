rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    // Users Collection
    // SECURITY: Users cannot self-assign 'Admin' role during registration or update.
    // Admin accounts must be created by an existing Admin or via Firebase Console.
    // Reading user profiles is restricted to the user themselves or Admins to protect personal data.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated()
                    && request.auth.uid == userId
                    && request.resource.data.role != 'Admin';
      allow update: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.role == resource.data.role
        && (!('isActive' in resource.data) || request.resource.data.isActive == resource.data.isActive)
      );
      allow delete: if isAdmin();
    }

    // Active Users Registry (for Common Notification routing without exposing private profiles)
    match /active_users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Lost Items Collection
    // Owners cannot hand a report over to someone else by rewriting ownerId.
    match /lostItems/{itemId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAdmin() || (
        isOwner(resource.data.ownerId)
        && request.resource.data.ownerId == resource.data.ownerId
      );
      allow delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // Found Items Collection
    match /foundItems/{itemId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.finderId == request.auth.uid;
      allow update: if isAdmin() || (
        isOwner(resource.data.finderId)
        && request.resource.data.finderId == resource.data.finderId
      );
      allow delete: if isAuthenticated() && (resource.data.finderId == request.auth.uid || isAdmin());
    }

    // Item Photos Collection
    // Photos are stored as bytes in Firestore because Firebase Storage needs the paid Blaze plan.
    // Size is capped below Firestore's 1 MiB document limit; photos cannot be edited, only replaced.
    match /itemImages/{imageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.resource.data.uploaderId == request.auth.uid
                    && request.resource.data.data is bytes
                    && request.resource.data.data.size() <= 900 * 1024;
      allow update: if false;
      allow delete: if isAuthenticated() && (resource.data.uploaderId == request.auth.uid || isAdmin());
    }

    // Claims Collection
    match /claims/{claimId} {
      allow read: if isAuthenticated() && (resource.data.claimantId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.claimantId == request.auth.uid;
      // Users cannot approve their own claims - only Admins can update claim status to APPROVED/REJECTED
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Notifications Collection
    // Users may only notify others about things they own: a broadcast about their
    // own new report (COMMON), a claim they submitted (CLAIM_SUBMITTED to admin), or
    // a match between their found item and someone's lost report (POTENTIAL_MATCH).
    function ownsReportedItem(data) {
      return (data.itemType == 'LOST'
                && get(/databases/$(database)/documents/lostItems/$(data.targetId)).data.ownerId == request.auth.uid)
          || (data.itemType == 'FOUND'
                && get(/databases/$(database)/documents/foundItems/$(data.targetId)).data.finderId == request.auth.uid);
    }

    function ownsSubmittedClaim(data) {
      return data.userId == 'admin'
          && get(/databases/$(database)/documents/claims/$(data.targetId)).data.claimantId == request.auth.uid;
    }

    // A finder may tell the owner of a lost report that their found item may match it.
    // The recipient must own the named lost report, so matches reach only that owner.
    function isMatchForLostOwner(data) {
      return data.itemType == 'FOUND'
          && get(/databases/$(database)/documents/foundItems/$(data.targetId)).data.finderId == request.auth.uid
          && get(/databases/$(database)/documents/lostItems/$(data.lostItemId)).data.ownerId == data.userId;
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.userId == 'all' || isAdmin());
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid
        || (request.resource.data.type == 'COMMON' && ownsReportedItem(request.resource.data))
        || (request.resource.data.type == 'CLAIM_SUBMITTED' && ownsSubmittedClaim(request.resource.data))
        || (request.resource.data.type == 'POTENTIAL_MATCH' && isMatchForLostOwner(request.resource.data))
        || isAdmin()
      );
      // Recipients can only mark their notifications as read, not rewrite them.
      allow update: if isAdmin() || (
        isOwner(resource.data.userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
      );
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Chats Collection
    // A chat is between exactly two people (owner and finder); the creator must be one of them.
    function isChatParticipant(chatId) {
      return request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
    }

    match /chats/{chatId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.participantIds || isAdmin());
      allow create: if isAuthenticated()
                    && request.resource.data.participantIds is list
                    && request.resource.data.participantIds.size() == 2
                    && request.auth.uid in request.resource.data.participantIds;
      allow update: if isAdmin() || (
        isAuthenticated()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds
      );
      allow delete: if isAdmin();

      // Messages live under their chat so only its participants can see them.
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (isChatParticipant(chatId) || isAdmin());
        allow create: if isAuthenticated()
                      && isChatParticipant(chatId)
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 2000;
        allow update: if isAuthenticated()
                      && isChatParticipant(chatId)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
        allow delete: if isAdmin();
      }
    }

    // Activity Logs Collection (Admin Dashboard)
    // Only admin pages write logs, so only admins may create or read them.
    match /activityLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
